# Cabeçalhos de segurança para todo o site. As regras de /expedicao abaixo
# complementam estas (lá Referrer-Policy e X-Frame-Options são mais restritos).
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=(), usb=()

# Arquivos estáticos que mudam pouco: cache de 30 dias no navegador.
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/icons/*
  Cache-Control: public, max-age=2592000
/assets/datasheets-view/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
# CSS e JS sem hash no nome: revalida sempre (304 quando não mudou).
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/site.webmanifest
  Content-Type: application/manifest+json
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# geolocation=(self) — Rota de entregas em lote: a cerca de 100m precisa da
# posição do celular. Só é pedida quando a rota está em andamento (nunca na
# tela de login/consulta avulsa); sem sinal ou sem permissão, a confirmação
# continua funcionando na mão, só sem o selo de localização.
/expedicao
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'

/expedicao/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'

/expedicao/manifest.webmanifest
  Content-Type: application/manifest+json
