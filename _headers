# geolocation=(self) — Rota de entregas em lote: a cerca de 100m precisa da
# posição do celular. Só é pedida quando a rota está em andamento (nunca na
# tela de login/consulta avulsa); sem sinal ou sem permissão, a confirmação
# continua funcionando na mão, só sem o selo de localização.
/expedicao
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'

/expedicao/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'

/expedicao/manifest.webmanifest
  Content-Type: application/manifest+json
